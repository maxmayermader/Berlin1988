{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@berlin/shared": ["../../packages/shared/src/index.ts"],
      "@berlin/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "components/**/*.ts", "components/**/*.tsx", "lib/**/*.ts", "e2e/**/*.ts", "next-env.d.ts"],
  "exclude": ["node_modules", ".next"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/engine" }]
}
